# Setup for BuildBuddy integration
common:remote-cache --bes_results_url=https://app.buildbuddy.io/invocation/
common:remote-cache --bes_backend=grpcs://remote.buildbuddy.io
common:remote-cache --remote_cache=grpcs://remote.buildbuddy.io
common:remote-cache --remote_timeout=10m
common:remote-cache --remote_cache_compression
common:remote-cache --guard_against_concurrent_changes
common:remote-cache --nolegacy_important_outputs

# common --config=remote-cache

common:remote-cache --credential_helper=remote.buildbuddy.io=%workspace%/tools/buildbuddy/credhelper
# common:remote-status --workspace_status_command=./tools/buildbuddy/workspace_status

# Config for disabling remote caching if you can't access it
common:offline --remote_cache="" --bes_backend=""
