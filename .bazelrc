import %workspace%/bazelrc/remote.bazelrc
import %workspace%/bazelrc/ci.bazelrc

# To debug: lldb bazel-bin/ratbag/cli/cli
# build:debug --spawn_strategy=local
# build:debug --sandbox_debug
build:debug --strip=never
build:debug -c dbg
build:debug --copt=-fno-omit-frame-pointer
build:debug --copt=-ferror-limit=1
# build:debug --copt=-O1
# build:debug --strip=never

# address sanitizer
build:asan --features=asan
# undefined behavior sanitizer
build:ubsan --features=ubsan
# memory sanitizer
build:msan --features=msan

# rules_lint
build:lint --aspects=//tools/lint:linters.bzl%clang_tidy
build:lint --aspects=//tools/lint:linters.bzl%cppcheck
build:lint --aspects=//tools/lint:linters.bzl%buildifier
build:lint --aspects=//tools/lint:linters.bzl%shellcheck
build:lint --output_groups=rules_lint_human

build:macos --macos_minimum_os=14.0 --host_macos_minimum_os=14.0 

# TODO: on mac combination of asan and ubsan causes exception in tests to not be caught
#       enabling sanitizer via --feastures=asan fails with unsupported option '-static-libgcc' 
test:macos --config=debug --config=lint
test:linux --config=debug --config=asan --config=ubsan --config=lint

# Enable hermetic `rules_python`, needed for herdron
common --@rules_python//python/config_settings:bootstrap_impl=script
common --enable_platform_specific_config
build --copt=-Werror
build --linkopt=-Werror
test --test_output=errors
