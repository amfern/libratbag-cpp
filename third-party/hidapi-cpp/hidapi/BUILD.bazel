load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "hid_report",
    hdrs = [
        "hid_report.hpp",
    ],
    deps = [
        "//hidapi/detail:hid_report_internal",
        "@hidapi",
    ],
    visibility = ["//hidapi:__subpackages__"],
)

cc_library(
    name = "device_info",
    srcs = [
        "device_info.cpp",
    ],
    hdrs = [
        "device_info.hpp",
    ],
    cxxopts = [
        # wstring_convert<std::codecvt_utf8<wchar_t>>' is deprecated
        "-Wno-deprecated-declarations",
    ],
    visibility = [
        "//hidapi:__subpackages__",
        "//tests:__subpackages__"
    ],
    deps = [
        "//hidapi/detail:hid_bus_type_internal",
        "@hidapi",
    ],
)

cc_library(
    name = "device",
    srcs = [
        "device.cpp",
    ],
    hdrs = [
        "device.hpp",
    ],
    cxxopts = [
        # wstring_convert<std::codecvt_utf8<wchar_t>>' is deprecated
        "-Wno-deprecated-declarations",
    ],
    visibility = [
        "//hidapi:__subpackages__",
        "//tests:__subpackages__"
    ],
    deps = [
        ":device_info",
        ":hid_report",
        "@hidapi",
    ],
)

cc_library(
    name = "hidapi",
    visibility = ["//hidapi:__subpackages__"],
    deps = [
        ":device_info",
        ":device",
        ":hid_report",
    ],
)
