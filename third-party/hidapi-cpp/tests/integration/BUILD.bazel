load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "test_device_info",
    srcs = ["test_device_info.cpp"],
    cxxopts = [
        # wstring_convert<std::codecvt_utf8<wchar_t>>' is deprecated
        "-Wno-deprecated-declarations",
    ],
    tags = [
        "external",  # hardware state isn't a Bazel input, so never cache the result
        "local",  # needs real /sys and /dev, so no sandbox
    ],
    deps = [
        "//hidapi:device_info",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_device_info_logitech_g502",
    srcs = ["test_device_info_logitech_g502.cpp"],
    cxxopts = [
        # wstring_convert<std::codecvt_utf8<wchar_t>>' is deprecated
        "-Wno-deprecated-declarations",
    ],
    tags = [
        "external",  # hardware state isn't a Bazel input, so never cache the result
        "local",  # needs real /sys and /dev, so no sandbox
    ],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    deps = [
        "//hidapi:device_info",
        "@googletest//:gtest_main",
    ],
)
