module(
    name = "hidapi-cpp",
    version = "0.0.1",
)

bazel_dep(name = "rules_cc", version = "0.2.16")

non_module_deps = use_extension("//:extension.bzl", "non_module_deps")
use_repo(
    non_module_deps,
    "hidapi",
)

bazel_dep(name = "rules_build_error", version = "0.11.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "googletest", version = "1.17.0", dev_dependency = True)

include("//:toolchain.MODULE.bazel")
